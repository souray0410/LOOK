# Local environments and Python caches
tool/environment/.venv/
tool/*.egg-info/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Interrupted and temporary writes
*.partial
*.tmp
*.lock

# Editors and operating systems
.DS_Store
.idea/
.vscode/
!.vscode/
!.vscode/settings.json

# LaTeX build products; sources and final PDFs remain tracked
*.aux
*.fdb_latexmk
*.fls
*.log
*.nav
*.out
*.snm
*.synctex.gz
*.toc
missfont.log

# Runtime data belongs under /data, never in the source tree
dataset/
cache/
runs/
